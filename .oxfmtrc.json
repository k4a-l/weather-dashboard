{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.expo/**",
		"**/android/**"
	]
}
